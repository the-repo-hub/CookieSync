[Unit]
Description=CookieSync WebSocket Server
After=network.target

[Service]
Type=simple
User=cookiesync
Group=cookiesync
WorkingDirectory=/opt/CookieSync
ExecStart=/opt/CookieSync/.venv/bin/python -m cookieserver.manage runserver
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077

[Install]
WantedBy=multi-user.target
