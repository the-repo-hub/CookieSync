{
  "manifest_version": 3,
  "name": "CookieSync Extension",
  "version": "1.0",
  "description": "Синхронизация куки между браузерами через WebSocket сервер",
  "permissions": ["storage", "cookies", "alarms"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CookieSync",
    "default_icon": "icon.ico"
  },
  "icons": {
    "16": "icon.ico",
    "48": "icon.ico",
    "128": "icon.ico"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cookiesync@extension",
      "strict_min_version": "121.0"
    }
  }
}
