{
  "manifest_version": 3,
  "name": "CookieSync Extension",
  "version": "1.0.2",
  "description": "Синхронизация куки между браузерами через WebSocket сервер",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "cookies", "alarms", "scripting"],
  "host_permissions": ["*://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' ws: wss: http: https:;"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["browser-polyfill.min.js", "logic.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://office.reso.ru/*"],
      "js": ["browser-polyfill.min.js", "authentication.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CookieSync",
    "default_icon": "icon.ico"
  },
  "icons": {
    "16": "icon.ico",
    "48": "icon.ico",
    "128": "icon.ico"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cookiesync@extension",
      "strict_min_version": "121.0"
    }
  }
}
